# Default: SQLite, zero setup required. The app creates backend/fraud.db automatically.
# Leave DATABASE_URL unset (or delete this line) to use SQLite.
# DATABASE_URL=sqlite:///./fraud.db

# To use PostgreSQL instead, uncomment and set:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraud_detection

JWT_SECRET=change-this-to-a-long-random-string
